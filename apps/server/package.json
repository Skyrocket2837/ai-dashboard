{
  "name": "@ai-dashboard/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "migrate": "node --experimental-strip-types src/migrate.ts"
  },
  "dependencies": {
    "@ai-dashboard/shared": "workspace:*",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.0.3",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
