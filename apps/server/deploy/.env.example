# Copy to /home/pi/ai-dashboard/.env on the Pi and chmod 600.
# Required.
AID_HMAC_SECRET=replace-with-secure-32-byte-hex-string

# Optional overrides (defaults shown).
AID_PORT=8787
AID_HOST=0.0.0.0
AID_DB_PATH=/home/pi/ai-dashboard/data/ai-dashboard.db
AID_PUBLIC_DIR=/home/pi/ai-dashboard/public
AID_LOG_LEVEL=info
AID_EVENT_RETENTION_DAYS=7
AID_PRUNE_INTERVAL_MS=3600000
NODE_ENV=production
