# Copy to .env (or set via Task Scheduler env) before starting.

# Cloudflare Tunnel public URL pointing at Pi server :8787
# AID_CLOUD_URL=https://ai-dashboard.example.com

# Same secret as Pi server. Must be >=32 chars.
# AID_HMAC_SECRET=replace-with-secure-32-byte-hex-string

# Optional override (defaults to os.hostname()).
# AID_MACHINE=desktop-1

# Local supervisor HTTP port (Claude hook-bridge.ps1 talks here).
AID_SUPERVISOR_PORT=7777
AID_SUPERVISOR_HOST=127.0.0.1

# RAM gating thresholds (megabytes).
# Soft (warning, ask user to confirm).
AID_RAM_THRESHOLD_MB=4096
# Hard (block subagent spawn outright).
AID_RAM_HARD_LIMIT_MB=2048

# Poll cadence for RAM monitor (ms).
AID_RAM_POLL_MS=5000

# Flush cadence for cloud push (ms).
AID_PUSH_INTERVAL_MS=1000

# Debug: force a fake RAM-available value (e.g. test gating).
# AID_MOCK_RAM_MB=1500
